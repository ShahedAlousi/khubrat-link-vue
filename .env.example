# Base URL of the Khibrat Laravel API (no trailing slash)
# Local backend:  VITE_API_BASE_URL=http://localhost:8000/api
# ngrok tunnel:   VITE_API_BASE_URL=https://<your-subdomain>.ngrok-free.app/api
VITE_API_BASE_URL=https://03e5-212-8-253-37.ngrok-free.app/api
#VITE_API_BASE_URL=http://localhost:8000/api

# The register endpoint (POST /api/companies/register) requires a plan_id.
# Since /api/subscription-plans is out of scope for this build, the "Create
# Your Free Workspace" flow sends this fixed plan id. Replace it with the
# real UUID of your "Free" plan.
VITE_FREE_PLAN_ID=00000000-0000-0000-0000-000000000000

# payment_status is a required field on the register payload but its
# accepted values are not documented in the API spec. "pending" is used as
# a safe default for a free-tier signup — confirm with the backend team.
VITE_FREE_PLAN_PAYMENT_STATUS=pending
